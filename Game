<!DOCTYPE html>
<html lang="sk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Futbalový Európsky Simulátor</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #121212;
            color: #ffffff;
            margin: 0;
            padding: 20px;
        }
        h1, h2 {
            text-align: center;
            color: #00ffcc;
        }
        .container {
            max-width: 900px;
            margin: 0 auto;
        }
        .nav-buttons {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }
        button {
            background-color: #1f1f1f;
            color: #ffffff;
            border: 2px solid #00ffcc;
            padding: 10px 15px;
            cursor: pointer;
            font-weight: bold;
            border-radius: 5px;
            transition: 0.2s;
        }
        button:hover {
            background-color: #00ffcc;
            color: #121212;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            background-color: #1e1e1e;
            margin-bottom: 20px;
            border-radius: 5px;
            overflow: hidden;
        }
        th, td {
            padding: 10px;
            text-align: left;
            border-bottom: 1px solid #333;
        }
        th {
            background-color: #2b2b2b;
            color: #00ffcc;
        }
        .actions {
            text-align: center;
            margin-bottom: 30px;
        }
        .sim-btn {
            background-color: #00ffcc;
            color: #121212;
            font-size: 16px;
            padding: 12px 25px;
        }
    </style>
</head>
<body>

<div class="container">
    <h1>Futbalový Simulátor Liga & Európske Poháre</h1>

    <!-- Výber súťaže -->
    <div class="nav-buttons">
        <button onclick="changeLeague('england')">Anglická Liga</button>
        <button onclick="changeLeague('spain')">Španielska Liga</button>
        <button onclick="changeLeague('germany')">Nemecká Liga</button>
        <button onclick="changeLeague('slovakia')">Slovenská Liga</button>
        <button onclick="changeLeague('ucl')">Liga Majstrov</button>
    </div>

    <h2 id="league-title">Anglická Liga</h2>

    <!-- Tabuľka -->
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Tím</th>
                <th>Z</th>
                <th>V</th>
                <th>R</th>
                <th>P</th>
                <th>Skóre</th>
                <th>B</th>
            </tr>
        </thead>
        <tbody id="standings-body">
            <!-- Dynamicky naplnené cez JS -->
        </tbody>
    </table>

    <div class="actions">
        <button class="sim-btn" onclick="simulateRound()">Simulovať Ďalšie Kolo</button>
    </div>
</div>

<script>
    // Dáta pre tímy v ligách
    const leaguesData = {
        england: [
            { name: "Man City", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 },
            { name: "Arsenal", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 },
            { name: "Liverpool", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 },
            { name: "Chelsea", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 },
            { name: "Man Utd", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 },
            { name: "Tottenham", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 }
        ],
        spain: [
            { name: "Real Madrid", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 },
            { name: "Barcelona", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 },
            { name: "Atlético Madrid", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 },
            { name: "Girona", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 },
            { name: "Athletic Bilbao", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 },
            { name: "Real Sociedad", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 }
        ],
        germany: [
            { name: "Bayern München", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 },
            { name: "Leverkusen", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 },
            { name: "Dortmund", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 },
            { name: "RB Leipzig", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 },
            { name: "Stuttgart", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 },
            { name: "Frankfurt", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 }
        ],
        slovakia: [
            { name: "Slovan Bratislava", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 },
            { name: "Spartak Trnava", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 },
            { name: "DAC Dunajská Streda", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 },
            { name: "MŠK Žilina", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 },
            { name: "MFK Ružomberok", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 },
            { name: "FK Železiarne Podbrezová", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 }
        ],
        ucl: [
            { name: "Víťaz 1 (čaká sa)", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 },
            { name: "Víťaz 2 (čaká sa)", p: 0, w: 0, d: 0, l: 0, gf: 0, ga: 0, pts: 0 }
        ]
    };

    let currentLeague = 'england';

    function changeLeague(leagueKey) {
        currentLeague = leagueKey;
        const titles = {
            england: "Anglická Liga",
            spain: "Španielska Liga",
            germany: "Nemecká Liga",
            slovakia: "Slovenská Liga",
            ucl: "Liga Majstrov"
        };
        document.getElementById('league-title').innerText = titles[leagueKey];
        renderTable();
    }

    function renderTable() {
        const tbody = document.getElementById('standings-body');
        tbody.innerHTML = '';
        
        // Zoradenie tímov podľa bodov a skóre
        leaguesData[currentLeague].sort((a, b) => b.pts - a.pts || (b.gf - b.ga) - (a.gf - a.ga));

        leaguesData[currentLeague].forEach((team, index) => {
            const row = `<tr>
                <td>${index + 1}</td>
                <td>${team.name}</td>
                <td>${team.p}</td>
                <td>${team.w}</td>
                <td>${team.d}</td>
                <td>${team.l}</td>
                <td>${team.gf}:${team.ga}</td>
                <td><strong>${team.pts}</strong></td>
            </tr>`;
            tbody.innerHTML += row;
        });
    }

    function simulateRound() {
        const teams = leaguesData[currentLeague];
        if (teams.length < 2) return;

        // Jednoduchá náhodná simulácia zápasov pre aktuálne tímy v lige
        for (let i = 0; i < teams.length; i += 2) {
            if (i + 1 < teams.length) {
                let t1 = teams[i];
                let t2 = teams[i+1];

                let g1 = Math.floor(Math.random() * 4);
                let g2 = Math.floor(Math.random() * 4);

                t1.p++; t2.p++;
                t1.gf += g1; t1.ga += g2;
                t2.gf += g2; t2.ga += g1;

                if (g1 > g2) {
                    t1.w++; t2.l++; t1.pts += 3;
                } else if (g1 < g2) {
                    t2.w++; t1.l++; t2.pts += 3;
                } else {
                    t1.d++; t2.d++; t1.pts += 1; t2.pts += 1;
                }
            }
        }
        renderTable();
    }

    // Inicializácia pri štarte
    renderTable();
</script>

</body>
</html>
